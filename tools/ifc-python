#!/usr/bin/env bash
# Source interpreter adapter: supports the plugin's Python -c and -m calls.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
exec env -u PYTHONPATH "${USDAECO_IFC_SOURCE_PYTHON:-python3}" -c '
import runpy, sys
sys.path.insert(0, sys.argv.pop(1))
import bootstrap
mode, target = sys.argv[1:3]
sys.argv = [target, *sys.argv[3:]]
if mode == "-m":
    runpy.run_module(target, run_name="__main__")
elif mode == "-c":
    sys.argv[0] = "-c"
    exec(target)
else:
    raise SystemExit("expected -m or -c")
' "$ROOT" "$@"
